{
  "name": "arnakoff-web",
  "version": "0.0.0",
  "private": true,
  "description": "Website and API documentation of Arnakoff, the French anti-scam API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-headers.mjs",
    "preview": "astro preview",
    "check": "astro check && eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test:site && npm run test:lighthouse",
    "test:site": "node scripts/check-contrast.mjs && node scripts/check-share.mjs && node scripts/check-site.mjs && node scripts/check-a11y.mjs",
    "test:lighthouse": "node scripts/check-lighthouse.mjs",
    "icons": "node scripts/build-icons.mjs",
    "sync": "node scripts/sync.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "starlight-openapi": "0.27.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "wrangler": "4.162.0"
  },
  "overrides": {
    "form-data": "4.0.6"
  }
}
