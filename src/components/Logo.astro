---
// The logo mark drawn with the color tokens, so it follows the theme. Same
// geometry as public/favicon.svg, without its white square. Decorative: the
// brand name is always written next to it.
---

<svg class="logo" viewBox="-96 -96 192 192" aria-hidden="true" focusable="false">
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <circle r="80" stroke="var(--color-alert)" stroke-width="14"></circle>
    <circle cx="10" cy="-50" r="8" stroke="var(--color-text)" stroke-width="8"></circle>
    <path
      d="M10 -42 V22 A28 28 0 0 1 -46 22 V6 L-34 18"
      stroke="var(--color-text)"
      stroke-width="12"
    ></path>
    <line x1="-56" y1="-56" x2="56" y2="56" stroke="var(--color-bg)" stroke-width="26"></line>
    <line x1="-56" y1="-56" x2="56" y2="56" stroke="var(--color-alert)" stroke-width="14"></line>
  </g>
</svg>

<style>
  .logo {
    width: 2rem;
    height: 2rem;
    flex: none;
  }
</style>
