---
// Applies the stored theme before the first paint, so a chosen theme never
// flashes the other one. Inline on purpose: it must run before the body. The
// Content-Security-Policy allows it by hash.
import { THEME_KEY } from '../lib/theme';
---

<script is:inline define:vars={{ key: THEME_KEY }}>
  try {
    const theme = localStorage.getItem(key);
    if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
  } catch {
    // Blocked storage: the system preference applies.
  }
</script>
