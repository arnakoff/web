---
// Document shell of every showcase page: metadata, tokens, theme.
import '../styles/tokens.css';
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeSelect from '../components/ThemeSelect.astro';
import { FAVICON_SVG, ICON_LINKS, shareImageMeta } from '../lib/meta';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeInit />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <link rel="icon" href={FAVICON_SVG} type="image/svg+xml" />
    {ICON_LINKS.map((attrs) => (
      <link {...attrs} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="fr" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Arnakoff" />
    <meta name="twitter:card" content="summary_large_image" />
    {shareImageMeta(url).map((attrs) => (
      <meta {...attrs} />
    ))}
  </head>
  <body>
    <header>
      <ThemeSelect />
    </header>
    <slot />
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: flex-end;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
</style>
