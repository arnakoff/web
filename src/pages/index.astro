---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { DOCS_PATH } from '../lib/site';

const title = 'Arnakoff';
const description = "Arnakoff, l'API française de signaux sourcés contre les arnaques.";
---

<Base title={title} description={description}>
  <h1>{title}</h1>
  <p>Le site est en construction.</p>
  <p>
    <Button href={DOCS_PATH}>Lire la documentation de l'API</Button>
  </p>
</Base>
