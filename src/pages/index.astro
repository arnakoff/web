---
import Base from '../layouts/Base.astro';
import { DOCS_PATH } from '../lib/site';

const title = 'Arnakoff';
const description = "Arnakoff, l'API française de signaux sourcés contre les arnaques.";
---

<Base title={title} description={description}>
  <main>
    <h1>{title}</h1>
    <p>Le site est en construction.</p>
    <p>
      <a href={DOCS_PATH}>Lire la documentation de l'API</a>
    </p>
  </main>
</Base>

<style>
  main {
    max-width: 45rem;
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
  }
</style>
